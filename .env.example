# =============================================================================
# Copie para .env e preencha. O .env NUNCA vai para o git (ver .gitignore).
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL (consumido pelo container `db` do docker-compose) ------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance
POSTGRES_PORT=5432

# --- Conexão da aplicação ----------------------------------------------------
# O host `db` é o nome do serviço no docker-compose. Rodando fora do Docker,
# troque por `localhost`.
#
# São DUAS identidades diferentes no banco, e a diferença é o que faz o RLS valer:
#
#   app_user  -> não é dono das tabelas, então as políticas de Row-Level Security
#                se aplicam a ele. É com este role que a aplicação conecta.
#   postgres  -> dono do schema; ignora RLS por design. Só as migrations usam.
#
# Se a aplicação conectasse como postgres, o RLS não bloquearia absolutamente nada.
APP_DB_USER=app_user
APP_DB_PASSWORD=troque-esta-senha

DATABASE_URL=postgresql+asyncpg://app_user:troque-esta-senha@db:5432/finance

# Alembic: driver síncrono (psycopg) e role owner, porque precisa criar tabelas.
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/finance

# Banco usado pela suíte de testes (criado e derrubado pelo pytest).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/finance_test

# --- Pluggy (Open Finance) ---------------------------------------------------
# Credenciais da Application criada em https://dashboard.pluggy.ai
# O tier pessoal ("Meu Pluggy") é gratuito e permanente para 1 CPF.
# Ainda não usadas em código — a integração é a Fase 2.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai

# itemId de uma conexão já existente em https://meu.pluggy.ai
# Opcional: atalho da Fase 2 para adotar uma conexão sem passar pelo widget.
PLUGGY_ITEM_ID=

# --- Ollama (roda no host, fora do Docker) -----------------------------------
# host.docker.internal resolve o host a partir do container no Docker Desktop.
# Rodando o backend fora do Docker, use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b

# --- Aplicação ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Chave Fernet para criptografia em repouso (Fase 5 — LGPD). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Origens liberadas no CORS (separadas por vírgula).
CORS_ORIGINS=http://localhost:3000

# --- Frontend ----------------------------------------------------------------
# NEXT_PUBLIC_* é embutido no bundle e fica visível no browser: nunca coloque
# segredo aqui. Esta URL é chamada pelo navegador, então é localhost e não `backend`.
NEXT_PUBLIC_API_URL=http://localhost:8000
